[Vertex]

#include "common.shd"

out vec2 TexCoord;

void main()
{
	gl_Position = /*MVP */ vec4(VertexPosition.x, VertexPosition.y, 0.0, 1.0);
	TexCoord = VertexTexCoord;
	//gl_Position = vec4(VertexPosition.x, VertexPosition.y, 0.0, 1.0);
}

[Fragment]

#include "common.shd"

in vec2 TexCoord;
out vec4 FragColor;

void main()
{
	FragColor = texture2D(ColorMap, TexCoord);
}


